\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Comparación del ataque del 51\,\% y de los bloques comprometidos por minería egoísta. Arriba: Figura~4 del artículo; abajo: reproducción, con la fila superior para el 51\,\% y la inferior para minería egoísta. Los paneles corresponden a 100, 1\,000 y 10\,000 nodos. La figura original proviene de \blx@tocontentsinit {0}\cite {pimpini2025rblocksim}.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cmp-ataques}{{9}{9}{Comparación del ataque del 51\,\% y de los bloques comprometidos por minería egoísta. Arriba: Figura~4 del artículo; abajo: reproducción, con la fila superior para el 51\,\% y la inferior para minería egoísta. Los paneles corresponden a 100, 1\,000 y 10\,000 nodos. La figura original proviene de \cite {pimpini2025rblocksim}}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Comparación del rendimiento. Arriba: Figura~6 del artículo, que incluye la referencia CBlockSim y el panel de 100\,000 nodos. Abajo: RBlockSim del artículo (líneas discontinuas) frente a la reproducción (líneas continuas) en 1, 4 y 8 hilos. La línea CBlockSim no se reproduce y el panel de 100\,000 no tiene equivalente directo.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cmp-rendimiento}{{10}{10}{Comparación del rendimiento. Arriba: Figura~6 del artículo, que incluye la referencia CBlockSim y el panel de 100\,000 nodos. Abajo: RBlockSim del artículo (líneas discontinuas) frente a la reproducción (líneas continuas) en 1, 4 y 8 hilos. La línea CBlockSim no se reproduce y el panel de 100\,000 no tiene equivalente directo}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparación del uso de memoria. Arriba: pico de RAM (Figura~7 del artículo frente a la reproducción). Abajo: evolución agregada (Figura~8 del artículo frente a la reproducción). El artículo reporta 100\,000 nodos; la reproducción, 50\,000. La caída final de la curva del artículo corresponde al cierre de la simulación; la reproducción recorta ese tramo para comparar la meseta.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cmp-memoria}{{11}{11}{Comparación del uso de memoria. Arriba: pico de RAM (Figura~7 del artículo frente a la reproducción). Abajo: evolución agregada (Figura~8 del artículo frente a la reproducción). El artículo reporta 100\,000 nodos; la reproducción, 50\,000. La caída final de la curva del artículo corresponde al cierre de la simulación; la reproducción recorta ese tramo para comparar la meseta}{figure.caption.14}{}}
